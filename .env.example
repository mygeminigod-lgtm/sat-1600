# Environment Variables Example for SAT 1600 Platform

# Google Gemini API Key (Optional for basic features, required for real-time live LLM tutor reasoning)
# Obtain from: https://aistudio.google.com/app/apikey
# If left empty, the application automatically uses the built-in deterministic expert AI tutor engine.
GEMINI_API_KEY=

# Application URL (for production sitemaps and metadata)
NEXT_PUBLIC_APP_URL=https://sat-1600.vercel.app
